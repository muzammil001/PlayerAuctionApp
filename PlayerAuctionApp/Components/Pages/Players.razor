@page "/players"
@rendermode InteractiveServer
@inject AuctionPlayerService PlayerService
@inject IJSRuntime JS

<PageTitle>Players</PageTitle>

<div class="mx-auto max-w-7xl space-y-8">
    <section class="overflow-hidden rounded-3xl bg-slate-950 px-6 py-8 text-white shadow-xl sm:px-10 sm:py-10">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
            <div>
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-300">Auction setup · Step
                    2</p>
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Player pool</h1>
                <p class="mt-3 max-w-xl text-slate-300">Register up to 96 players. Their team assignment will appear
                    here after an auction purchase.</p>
            </div>
            <div class="min-w-56 rounded-2xl bg-white/10 p-4">
                <div class="flex items-center justify-between gap-3">
                    <p class="text-sm text-slate-300">Players registered</p>
                    <p class="text-lg font-bold">@players.Count <span
                            class="text-sm font-medium text-slate-400">/ @maximumPlayers</span></p>
                </div>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/15">
                    <div class="h-full rounded-full bg-emerald-400 transition-all"
                         style="width: @($"{ProgressPercent}%")"></div>
                </div>
            </div>
        </div>
    </section>

    <div class="space-y-5">
        <nav class="flex gap-2 border-b border-slate-200" role="tablist" aria-label="Player management">
            <button type="button" role="tab" aria-selected="@(activeTab == "list" ? "true" : "false")"
                    class="@TabClass("list")" @onclick="ShowPlayerList">
                <i class="fa-solid fa-users" aria-hidden="true"></i> Registered Players <span
                    class="rounded-full bg-slate-100 px-2 py-0.5 text-xs">@players.Count</span>
            </button>
            <button type="button" role="tab" aria-selected="@(activeTab == "add" ? "true" : "false")"
                    class="@TabClass("add")" @onclick="ShowAddPlayer">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i> Add Player
            </button>
        </nav>

        @if (activeTab == "list")
        {
            <section role="tabpanel" class="min-w-0 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                <div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">Registered players</h2>
                        <p class="mt-1 text-sm text-slate-500">Player details and auction status.</p>
                    </div>
                    <label class="relative block sm:w-64 py-3">
                        <input type="search" aria-label="Search players by name" value="@searchTerm"
                               @oninput="SearchChanged"
                               class="w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100"
                               placeholder="Search players by name"/>
                    </label>
                </div>

                @if (FilteredPlayers.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-10 text-center">
                        <i class="fa-solid fa-user-plus mb-3 text-2xl text-slate-400" aria-hidden="true"></i>
                        <p class="font-semibold text-slate-800">@(players.Count == 0 ? "No players registered yet" : "No matching players")</p>
                        <p class="mt-1 text-sm text-slate-500">@(players.Count == 0 ? "Add the first player using the form." : "Try a different player name.")</p>
                    </div>
                }
                else
                {
                    <div class="max-h-[42rem] overflow-auto rounded-2xl border border-slate-200">
                        <table class="min-w-[900px] w-full border-collapse text-left text-sm">
                            <thead class="sticky top-0 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <tr>
                                <th class="px-4 py-3 font-semibold">Player</th>
                                <th class="px-4 py-3 font-semibold">Role</th>
                                <th class="px-4 py-3 font-semibold">City</th>
                                <th class="px-4 py-3 font-semibold">Base price</th>
                                <th class="px-4 py-3 font-semibold">Team</th>
                                <th class="px-4 py-3 font-semibold">Actions</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                            @foreach (var player in CurrentPagePlayers)
                            {
                                <tr @key="player.Id" class="player-row-enter hover:bg-slate-50/70">
                                    <td class="px-4 py-3.5">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrWhiteSpace(player.Photo))
                                            {
                                                <img src="@player.Photo" alt="@player.FullName"
                                                     class="size-10 rounded-full border border-slate-200 object-cover"/>
                                            }
                                            else
                                            {
                                                <span
                                                    class="flex size-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-700"><i
                                                        class="fa-solid fa-user" aria-hidden="true"></i></span>
                                            }
                                            <div class="min-w-0">
                                                <p class="font-semibold text-slate-900">@player.FullName</p>
                                                <p class="text-xs text-slate-500">
                                                    Age @player.Age · @player.BattingHand-hand batter</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3.5"><span
                                            class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">@RoleLabel(player.Role)</span>
                                    </td>
                                    <td class="px-4 py-3.5 text-slate-600">@player.City</td>
                                    <td class="px-4 py-3.5 font-semibold text-slate-800">@player.BasePricePoints.ToString("N0")</td>
                                    <td class="px-4 py-3.5">
                                        @if (string.IsNullOrWhiteSpace(player.TeamName))
                                        {
                                            <span class="text-slate-400">Available</span>
                                        }
                                        else
                                        {
                                            <span class="font-medium text-emerald-700">@player.TeamName</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3.5"><div class="flex gap-2"><button type="button" @onclick="() => EditPlayer(player)" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Edit</button><button type="button" @onclick="() => DeletePlayer(player)" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50">Delete</button></div></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 flex flex-col items-center justify-between gap-3 sm:flex-row">
                        <p class="text-sm text-slate-500">
                            Showing @FirstVisiblePlayer–@LastVisiblePlayer of @FilteredPlayers.Count players</p>
                        <nav class="flex flex-wrap items-center justify-center gap-1" aria-label="Player list pages">
                            <button type="button" @onclick="PreviousPage" disabled="@(currentPage == 1)"
                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i><span>Previous</span>
                            </button>
                            @for (var page = 1; page <= TotalPages; page++)
                            {
                                var pageNumber = page;
                                <button type="button" @onclick="() => GoToPage(pageNumber)"
                                        aria-current="@(currentPage == pageNumber ? "page" : null)"
                                        class="@PageButtonClass(pageNumber)">@pageNumber</button>
                            }
                            <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                                    class="inline-flex items-center gap-1 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                                <span>Next</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                            </button>
                        </nav>
                    </div>
                }
            </section>
        }
        else
        {
            <section role="tabpanel" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                <div class="mb-6">
                    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-700">Player registration</p>
                    <h2 class="mt-1 text-xl font-bold text-slate-900">@(editingPlayerId is null ? "Add a player" : "Edit player")</h2>
                    <p class="mt-1 text-sm text-slate-500">Player details used in the auction and team squad.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div
                        class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"
                        role="status">@message</div>
                }
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div
                        class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800"
                        role="alert">@error</div>
                }
                @if (players.Count >= maximumPlayers)
                {
                    <div
                        class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900"
                        role="status">The maximum of 96 players has been reached.
                    </div>
                }

                <EditForm Model="input" OnValidSubmit="SavePlayer">
                    <DataAnnotationsValidator/>
                    <div class="space-y-4">
                        <label class="block">
                            <span class="mb-1.5 block text-sm font-medium text-slate-700">Full name <span
                                    class="text-red-600">*</span></span>
                            <InputText @bind-Value="input.FullName"
                                       class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-slate-900 outline-none placeholder:text-slate-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100"
                                       placeholder="Player's full name"/>
                            <ValidationMessage For="() => input.FullName" class="mt-1 block text-sm text-red-600"/>
                        </label>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <label class="block">
                                <span class="mb-1.5 block text-sm font-medium text-slate-700">Date of birth <span
                                        class="text-red-600">*</span></span>
                                <InputDate @bind-Value="input.DateOfBirth" max="@today"
                                           class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100"/>
                                <ValidationMessage For="() => input.DateOfBirth"
                                                   class="mt-1 block text-sm text-red-600"/>
                            </label>
                            <label class="block">
                                <span class="mb-1.5 block text-sm font-medium text-slate-700">City <span
                                        class="text-red-600">*</span></span>
                                <InputSelect @bind-Value="input.City"
                                             class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100">
                                    <option value="">Select a city</option>
                                    @foreach (var city in cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => input.City" class="mt-1 block text-sm text-red-600"/>
                            </label>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <label class="block">
                                <span class="mb-1.5 block text-sm font-medium text-slate-700">Player role <span
                                        class="text-red-600">*</span></span>
                                <InputSelect @bind-Value="input.Role"
                                             class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100">
                                    <option value="">Choose role</option>
                                    <option value="@PlayerRole.Batter">Batter</option>
                                    <option value="@PlayerRole.Bowler">Bowler</option>
                                    <option value="@PlayerRole.AllRounder">All-rounder</option>
                                    <option value="@PlayerRole.WicketKeeper">Wicket-keeper</option>
                                </InputSelect>
                                <ValidationMessage For="() => input.Role" class="mt-1 block text-sm text-red-600"/>
                            </label>
                            <label class="block">
                                <span class="mb-1.5 block text-sm font-medium text-slate-700">Bats <span
                                        class="text-red-600">*</span></span>
                                <InputSelect @bind-Value="input.BattingHand"
                                             class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100">
                                    <option value="">Choose hand</option>
                                    <option value="@BattingHand.Right">Right-handed</option>
                                    <option value="@BattingHand.Left">Left-handed</option>
                                </InputSelect>
                                <ValidationMessage For="() => input.BattingHand"
                                                   class="mt-1 block text-sm text-red-600"/>
                            </label>
                        </div>
                        <label class="block">
                            <span class="mb-1.5 block text-sm font-medium text-slate-700">Bowling style <span
                                    class="text-slate-400">(optional)</span></span>
                            <InputSelect @bind-Value="input.BowlingStyle"
                                         class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100">
                                <option value="">Not a bowler / not specified</option>
                                @foreach (var style in bowlingStyles)
                                {
                                    <option value="@style">@style</option>
                                }
                            </InputSelect>
                        </label>
                        <label class="block">
                            <span class="mb-1.5 block text-sm font-medium text-slate-700">Base price <span
                                    class="text-red-600">*</span></span>
                            <div class="relative">
                                <InputNumber @bind-Value="input.BasePricePoints" min="1"
                                             class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 pr-20 text-slate-900 outline-none focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100"/>
                                <span
                                    class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400">points</span>
                            </div>
                            <ValidationMessage For="() => input.BasePricePoints"
                                               class="mt-1 block text-sm text-red-600"/>
                        </label>
                        <div>
                            <span class="mb-1.5 block text-sm font-medium text-slate-700">Player photo <span
                                    class="text-slate-400">(optional)</span></span>
                            <div class="flex items-center gap-4 rounded-xl border border-dashed border-slate-300 p-4">
                                @if (!string.IsNullOrWhiteSpace(input.PhotoDataUrl))
                                {
                                    <img src="@input.PhotoDataUrl" alt="Player photo preview"
                                         class="size-14 rounded-full border border-slate-200 object-cover"/>
                                }
                                else
                                {
                                    <span
                                        class="flex size-14 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-400"><i
                                            class="fa-solid fa-user" aria-hidden="true"></i></span>
                                }
                                <div class="min-w-0">
                                    <InputFile OnChange="PhotoChanged"
                                               accept="image/png,image/jpeg,image/webp,image/gif"
                                               class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-3 file:py-2 file:font-semibold file:text-emerald-800 hover:file:bg-emerald-100"/>
                                    <p class="mt-2 text-xs text-slate-500">PNG, JPG, WEBP or GIF · up to 2 MB</p>
                                    @if (!string.IsNullOrWhiteSpace(photoError))
                                    {
                                        <p class="mt-1 text-sm text-red-600" role="alert">@photoError</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 flex gap-3"><button type="submit" class="rounded-xl bg-emerald-700 px-5 py-3 font-semibold text-white">@(editingPlayerId is null ? "Add player" : "Save changes")</button>@if (editingPlayerId is not null){<button type="button" @onclick="CancelEdit" class="rounded-xl border border-slate-300 px-5 py-3 font-semibold text-slate-700">Cancel</button>}</div>
                </EditForm>
            </section>
        }
    </div>
</div>

@code {
    private const int maximumPlayers = 96;
    private const int pageSize = 10;
    private NewPlayerInput input = new();
    private Guid? editingPlayerId;
    private IReadOnlyList<PlayerSummary> players = [];
    private string? searchTerm;
    private string? message;
    private string? error;
    private string? photoError;
    private string activeTab = "list";
    private int currentPage = 1;
    private string today = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
    private readonly string[] cities = ["Karachi", "Lahore", "Islamabad", "Rawalpindi", "Peshawar", "Quetta", "Multan", "Faisalabad", "Sialkot", "Gujranwala", "Hyderabad", "Bahawalpur", "Sargodha", "Abbottabad"];
    private readonly string[] bowlingStyles = ["Right-arm fast", "Left-arm fast", "Right-arm medium", "Left-arm medium", "Right-arm off-break", "Right-arm leg-break", "Left-arm orthodox", "Left-arm wrist spin"];

    private int ProgressPercent => (int)Math.Round(players.Count * 100d / maximumPlayers);

    private IReadOnlyList<PlayerSummary> FilteredPlayers => string.IsNullOrWhiteSpace(searchTerm)
        ? players
        : players.Where(player => player.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<PlayerSummary> CurrentPagePlayers => FilteredPlayers
        .Skip((currentPage - 1) * pageSize).Take(pageSize).ToArray();

    private int TotalPages => Math.Max(1, (FilteredPlayers.Count + pageSize - 1) / pageSize);
    private int FirstVisiblePlayer => FilteredPlayers.Count == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int LastVisiblePlayer => Math.Min(currentPage * pageSize, FilteredPlayers.Count);

    private string TabClass(string tab) => activeTab == tab
        ? "-mb-px inline-flex items-center gap-2 border-b-2 border-emerald-600 px-4 py-3 text-sm font-semibold text-emerald-700"
        : "-mb-px inline-flex items-center gap-2 border-b-2 border-transparent px-4 py-3 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700";

    private void ShowPlayerList() => activeTab = "list";

    private void ShowAddPlayer() => activeTab = "add";

    private string PageButtonClass(int page) => currentPage == page
        ? "min-w-9 rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white"
        : "min-w-9 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50";

    private void SearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString();
        currentPage = 1;
    }

    private void GoToPage(int page) => currentPage = Math.Clamp(page, 1, TotalPages);

    private void PreviousPage() => GoToPage(currentPage - 1);

    private void NextPage() => GoToPage(currentPage + 1);

    protected override async Task OnInitializedAsync() => await RefreshPlayers();

    private async Task RefreshPlayers() => players = await PlayerService.GetPlayersAsync();

    private async Task PhotoChanged(InputFileChangeEventArgs eventArgs)
    {
        photoError = null;
        var file = eventArgs.File;
        var allowedTypes = new[] { "image/png", "image/jpeg", "image/webp", "image/gif" };

        if (!allowedTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            photoError = "Choose a PNG, JPG, WEBP or GIF image.";
            input.PhotoDataUrl = null;
            return;
        }

        if (file.Size > 2 * 1024 * 1024)
        {
            photoError = "Photo must be 2 MB or smaller.";
            input.PhotoDataUrl = null;
            return;
        }

        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        input.PhotoDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }

    private void EditPlayer(PlayerSummary player)
    {
        editingPlayerId = player.Id; input = new NewPlayerInput { FullName = player.FullName, DateOfBirth = player.DateOfBirth, City = player.City, Role = player.Role, BattingHand = player.BattingHand, BowlingStyle = player.BowlingStyle, BasePricePoints = player.BasePricePoints, PhotoDataUrl = player.Photo };
        activeTab = "add"; message = null; error = null;
    }

    private void CancelEdit() { editingPlayerId = null; input = new NewPlayerInput(); photoError = null; }

    private async Task DeletePlayer(PlayerSummary player)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {player.FullName}?")) return;
        error = await PlayerService.DeletePlayerAsync(player.Id); message = error is null ? $"{player.FullName} deleted." : null;
        await RefreshPlayers(); currentPage = Math.Min(currentPage, TotalPages);
    }

    private async Task SavePlayer()
    {
        error = editingPlayerId is Guid id ? await PlayerService.UpdatePlayerAsync(id, input) : await PlayerService.AddPlayerAsync(input);
        if (error is not null)
        {
            message = null;
            return;
        }

        message = editingPlayerId is null ? $"{input.FullName.Trim()} has been registered." : $"{input.FullName.Trim()} updated.";
        editingPlayerId = null;
        input = new NewPlayerInput();
        photoError = null;
        await RefreshPlayers();
        activeTab = "list";
    }

    private static string RoleLabel(PlayerRole role) => role switch
    {
        PlayerRole.AllRounder => "All-rounder",
        PlayerRole.WicketKeeper => "Wicket-keeper",
        _ => role.ToString(),
    };

}
