@page "/"
@rendermode InteractiveServer
@inject AuctionTeamService TeamService

<PageTitle>Auction Dashboard</PageTitle>

<div class="mx-auto max-w-7xl space-y-8">
    <section class="overflow-hidden rounded-3xl bg-slate-950 px-6 py-10 text-white shadow-xl sm:px-10 sm:py-14">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-300">Cricket Player Auction</p>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Auction dashboard</h1>
        <p class="mt-3 max-w-2xl text-slate-300">Set up your teams, register players, and run the auction from one place.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
            <NavLink href="/teams" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white transition hover:bg-emerald-500">
                <i class="fa-solid fa-people-group" aria-hidden="true"></i> Manage teams
            </NavLink>
            <span class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-slate-200">@teams.Count teams registered</span>
        </div>
    </section>

    <section class="grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700"><i class="fa-solid fa-people-group" aria-hidden="true"></i></div>
            <h2 class="mt-5 font-bold text-slate-900">Teams</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">Add team names and owner contact details. Each team gets 100,000 starting points and 3 cash buys.</p>
            <NavLink href="/teams" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800">Open teams <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></NavLink>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex size-11 items-center justify-center rounded-xl bg-blue-100 text-blue-700"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></div>
            <h2 class="mt-5 font-bold text-slate-900">Players</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">Player registration for the 96-player pool is the next setup step.</p>
            <NavLink href="/players" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800">Open players <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></NavLink>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex size-11 items-center justify-center rounded-xl bg-amber-100 text-amber-700"><i class="fa-solid fa-gavel" aria-hidden="true"></i></div>
            <h2 class="mt-5 font-bold text-slate-900">Auction</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">Purchased players will be added to their team squad with the purchase details.</p>
            <NavLink href="/auction" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 hover:text-emerald-800">Open auction room <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></NavLink>
        </article>
    </section>
</div>

@code {
    private IReadOnlyList<TeamSummary> teams = [];

    protected override async Task OnInitializedAsync() => teams = await TeamService.GetTeamsAsync();
}
