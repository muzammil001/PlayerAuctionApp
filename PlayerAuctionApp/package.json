{
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  },
  "scripts": {
    "build:css": "npm run copy:fontawesome && tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/app.css",
    "watch:css": "npm run copy:fontawesome && tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/app.css --watch",
    "copy:fontawesome": "node scripts/copy-fontawesome.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
